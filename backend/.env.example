# Copy to .env (never commit .env).

# "fake" (default): a simulated Bolna, no real call is ever placed. "real": talks to api.bolna.ai.
BOLNA_MODE=fake

# Only used when BOLNA_MODE=real. Stays on the server, never sent to the browser.
BOLNA_API_KEY=

# Optional. If empty there is NO login and the app only starts on 127.0.0.1.
APP_PASSWORD=

# SQLite by default (WAL mode). A Postgres URL also works, e.g. postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./bolna_manager.db

# Seconds between checks of active calls.
POLL_SECONDS=5

# Sync numbers from the Bolna account. Found numbers are listed as "Discovered" and need approval.
# Minutes between syncs (also runs once at startup). 0 turns the schedule off.
SYNC_INTERVAL_MINUTES=60
# true = discovered numbers NOT linked to an agent in Bolna go straight into the pool.
SYNC_AUTO_APPROVE=false

# Spam Check. Test calls cost money and are only ever placed when a person presses the button.
# Most numbers one run may test. 0 = no cap.
SPAM_TEST_MAX_PER_RUN=0
# A test result nobody marks is dismissed after this many hours.
TEST_RESULT_EXPIRY_HOURS=24
# Releasing a spam number permanently DELETES it from your Bolna account. Off unless you turn it on.
ALLOW_BOLNA_NUMBER_DELETE=true

# Optional tuning
# MIN_CONNECTED_SECONDS=1
# CALL_TIMEOUT_MINUTES=30
# HOST=127.0.0.1
# PORT=8000
